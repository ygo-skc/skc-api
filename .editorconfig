root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
indent_style = space
indent_size = 4
max_line_length = 200
# ktlint_official mandates trailing commas; these permit ktlint to add them
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Cucumber step definitions are named after their Gherkin sentence, so snake_case is intentional
[src/integTest/**/*.kt]
ktlint_standard_function-naming = disabled
